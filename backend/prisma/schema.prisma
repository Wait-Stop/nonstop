generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id       String  @id @default(uuid()) @db.Uuid
  email    String?
  password String?
  name     String?

  // 상세 프로필
  age               Int?
  gender            String?
  current_region    String?
  major             String?
  job               String?
  salary            String?
  rent              String?
  deposit           String?
  transport         String?
  preferred_regions String[]
  recommend_region  Boolean  @default(false)

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  simulations         Simulation[]
  saved_regions       SavedRegion[]
  saved_policies      SavedPolicy[]
  policy_checklists   PolicyChecklist[]
  community_posts     CommunityPost[]
  community_comments  CommunityComment[]
  community_reactions CommunityReaction[]

  @@map("Users")
}

model Region {
  id         String    @id @default(uuid()) @db.Uuid
  code       String?   @unique
  name       String?
  population Int?
  avg_cost   Int?
  job_score  Int?
  life_score Int?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  simulations   Simulation[]
  policies      Policy[]
  saved_regions SavedRegion[]

  @@map("regions")
}

model Policy {
  id          String    @id @default(uuid()) @db.Uuid
  code        String?   @unique
  region_id   String?   @db.Uuid
  title       String?
  description String?
  category    String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)

  region            Region?           @relation(fields: [region_id], references: [id])
  saved_policies    SavedPolicy[]
  policy_checklists PolicyChecklist[]

  @@map("policies")
}

model Simulation {
  id        String  @id @default(uuid()) @db.Uuid
  user_id   String? @db.Uuid
  region_id String? @db.Uuid
  score     Int?

  condition Json?
  results   Json?

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  user   User?   @relation(fields: [user_id], references: [id])
  region Region? @relation(fields: [region_id], references: [id])

  @@map("simulations")
}

model SavedRegion {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  region_id  String   @db.Uuid
  score      Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  region Region @relation(fields: [region_id], references: [id], onDelete: Cascade)

  @@unique([user_id, region_id])
  @@map("saved_regions")
}

model SavedPolicy {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  policy_id  String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  @@unique([user_id, policy_id])
  @@map("saved_policies")
}

model PolicyChecklist {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  policy_id     String   @db.Uuid
  checked_items Json?
  updated_at    DateTime @updatedAt @db.Timestamptz(6)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  policy Policy @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  @@unique([user_id, policy_id])
  @@map("policy_checklists")
}

model CommunityPost {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  category   String
  title      String
  content    String
  view_count Int       @default(0)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  user      User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  comments  CommunityComment[]
  reactions CommunityReaction[]

  @@index([category])
  @@index([created_at])
  @@map("community_posts")
}

model CommunityComment {
  id         String    @id @default(uuid()) @db.Uuid
  post_id    String    @db.Uuid
  user_id    String    @db.Uuid
  content    String
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @updatedAt @db.Timestamptz(6)

  post CommunityPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([post_id, created_at])
  @@map("community_comments")
}

model CommunityReaction {
  id         String   @id @default(uuid()) @db.Uuid
  post_id    String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  post CommunityPost @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([post_id, user_id])
  @@index([user_id])
  @@map("community_reactions")
}
