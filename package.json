{
  "name": "chungbuk-ollgyeo-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:ai": "node scripts/dev-ai.mjs",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "npm --prefix backend install",
    "test": "npm run build && npm --prefix backend test -- --runInBand && node scripts/test-ai.mjs"
  }
}
